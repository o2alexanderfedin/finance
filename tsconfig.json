{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    // "rootDir": "./src",
    // "outDir": "./dist",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "nodenext",
    "target": "esnext",
    "types": [],
    "allowJs": true,
    "checkJs": true,
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node

    // Other Outputs
    "noEmit": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,

    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "forceConsistentCasingInFileNames": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  },

  // The `functionalscript` submodule is upstream's own checkout, not our source, and it
  // is configured differently on purpose: it enables `allowImportingTsExtensions`, which
  // we do not, and leaves `noUnusedLocals`, `noUnusedParameters`,
  // `noUncheckedIndexedAccess` and `noPropertyAccessFromIndexSignature` off, which we
  // turn on. Checking it under our settings reports thousands of errors that are
  // configuration mismatches, not defects — it compiles cleanly under its own tsconfig
  // and its CI is green. Excluding it scopes this project to our code; it does not relax
  // a flag for our code. `node_modules` is named because declaring `exclude` replaces the
  // default rather than extending it.
  "exclude": ["functionalscript", "node_modules"],
}
